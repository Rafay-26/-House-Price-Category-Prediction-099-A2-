# Ye libraries data ko read, process aur visualize karne ke liye hain
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
df = pd.read_csv("train.csv")

# Ye libraries Machine Learning ke models aur evaluation ke liye hain
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestClassifier

# Ye metrics models ki performance check karne ke liye hain
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score,
    accuracy_score,
    confusion_matrix,
    classification_report
)


# ============================================================
# 1. DATASET LOAD KARNA
# ============================================================

# Yahan apni dataset ki file ka naam likho
# Agar train.csv isi folder mein hai to ye directly kaam karega
df = pd.read_csv("train.csv")

print("\nDataset successfully load ho gaya!")
print("Dataset Shape:", df.shape)

# Dataset ki first 5 rows dekh rahe hain
print("\nFirst 5 Rows:")
print(df.head())


# ============================================================
# 2. DATASET KI BASIC INFORMATION
# ============================================================

# Dataset ke columns aur data types check kar rahe hain
print("\nDataset Information:")
print(df.info())

# Missing values check kar rahe hain
print("\nMissing Values:")
print(df.isnull().sum().sort_values(ascending=False).head(15))


# ============================================================
# 3. SALE PRICE KI BASIC INFORMATION
# ============================================================

# SalePrice hamara main target hai
# Isi ko Linear Regression se predict karna hai
print("\nSalePrice Statistics:")
print(df["SalePrice"].describe())


# ============================================================
# 4. HOUSE PRICE KI VISUALIZATION
# ============================================================

# House prices ki distribution ka graph bana rahe hain
plt.figure(figsize=(10, 5))

sns.histplot(df["SalePrice"], kde=True)

plt.title("Distribution of House Prices")
plt.xlabel("Sale Price")
plt.ylabel("Number of Houses")

plt.show()


# ============================================================
# 5. OUTLIERS REMOVE KARNA
# ============================================================

# GrLivArea house ka living area hai
# Bohat extreme values model ko affect kar sakti hain
# Is liye unusual houses ko remove kar rahe hain

df = df[
    (df["GrLivArea"] < 4000) &
    (df["SalePrice"] < 800000)
]

print("\nOutliers remove karne ke baad dataset shape:")
print(df.shape)


# ============================================================
# 6. AREA AUR PRICE KA RELATIONSHIP
# ============================================================

# Living Area aur House Price ka relationship graph mein dekh rahe hain
plt.figure(figsize=(8, 5))

sns.scatterplot(
    data=df,
    x="GrLivArea",
    y="SalePrice"
)

plt.title("Living Area vs House Price")
plt.xlabel("Living Area")
plt.ylabel("Sale Price")

plt.show()


# ============================================================
# 7. LOW, MEDIUM AUR HIGH CATEGORY BANANA
# ============================================================

# SalePrice ko 3 categories mein divide kar rahe hain
# Low = kam price
# Medium = darmiyani price
# High = zyada price

df["PriceCategory"] = pd.qcut(
    df["SalePrice"],
    q=3,
    labels=["Low", "Medium", "High"]
)

print("\nPrice Categories:")
print(df["PriceCategory"].value_counts())


# ============================================================
# 8. PRICE CATEGORY KI VISUALIZATION
# ============================================================

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="PriceCategory"
)

plt.title("House Price Categories")
plt.xlabel("Price Category")
plt.ylabel("Number of Houses")

plt.show()


# ============================================================
# 9. FEATURES SELECT KARNA
# ============================================================

# Ye features house ki important information provide karte hain
features = [
    "OverallQual",
    "GrLivArea",
    "GarageCars",
    "TotalBsmtSF",
    "FullBath",
    "YearBuilt",
    "BedroomAbvGr"
]

# Input features
X = df[features].copy()

# Linear Regression ka target
y_price = df["SalePrice"]

# Random Forest ka target
y_category = df["PriceCategory"]


# ============================================================
# 10. MISSING VALUES HANDLE KARNA
# ============================================================

# Selected columns mein agar koi value missing hai
# to usko median value se replace kar rahe hain

for column in X.columns:
    X[column] = X[column].fillna(X[column].median())

print("\nMissing Values Handle Karne Ke Baad:")
print(X.isnull().sum())


# ============================================================
# 11. TRAIN TEST SPLIT
# ============================================================

# Dataset ka 80% training aur 20% testing ke liye use hoga

X_train, X_test, y_price_train, y_price_test, y_category_train, y_category_test = train_test_split(
    X,
    y_price,
    y_category,
    test_size=0.20,
    random_state=42,
    stratify=y_category
)

print("\nTraining Data:", X_train.shape)
print("Testing Data:", X_test.shape)


# ============================================================
# 12. FEATURE SCALING
# ============================================================

# Features ko same scale par la rahe hain
# Ye preprocessing ka part hai

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

print("\nFeature Scaling Complete!")


# ============================================================
# 13. MODEL 1 - LINEAR REGRESSION
# ============================================================

# Linear Regression house ki exact price predict karega
linear_model = LinearRegression()

# Model ko training data par train kar rahe hain
linear_model.fit(
    X_train_scaled,
    y_price_train
)

# Test data ki prices predict kar rahe hain
y_price_pred = linear_model.predict(X_test_scaled)

print("\nLinear Regression Model Successfully Trained!")


# ============================================================
# 14. LINEAR REGRESSION KI EVALUATION
# ============================================================

# MAE calculate kar rahe hain
mae = mean_absolute_error(
    y_price_test,
    y_price_pred
)

# RMSE calculate kar rahe hain
rmse = np.sqrt(
    mean_squared_error(
        y_price_test,
        y_price_pred
    )
)

# R2 Score calculate kar rahe hain
r2 = r2_score(
    y_price_test,
    y_price_pred
)

print("\n========== LINEAR REGRESSION RESULTS ==========")
print("Mean Absolute Error:", mae)
print("Root Mean Squared Error:", rmse)
print("R2 Score:", r2)


# ============================================================
# 15. ACTUAL VS PREDICTED PRICE
# ============================================================

# Actual aur predicted prices ko compare kar rahe hain
plt.figure(figsize=(8, 6))

plt.scatter(
    y_price_test,
    y_price_pred
)

plt.xlabel("Actual House Price")
plt.ylabel("Predicted House Price")

plt.title("Actual vs Predicted House Prices")

plt.show()


# ============================================================
# 16. MODEL 2 - RANDOM FOREST CLASSIFIER
# ============================================================

# Random Forest house ko Low, Medium ya High category mein
# classify karega

random_forest = RandomForestClassifier(
    n_estimators=100,
    random_state=42
)

# Classification model ko training data par train kar rahe hain
random_forest.fit(
    X_train,
    y_category_train
)

print("\nRandom Forest Model Successfully Trained!")


# ============================================================
# 17. PRICE CATEGORY PREDICTION
# ============================================================

# Test houses ki categories predict kar rahe hain
y_category_pred = random_forest.predict(X_test)

print("\nFirst 20 Predicted Categories:")
print(y_category_pred[:20])


# ============================================================
# 18. RANDOM FOREST KI ACCURACY
# ============================================================

# Model ki accuracy calculate kar rahe hain
accuracy = accuracy_score(
    y_category_test,
    y_category_pred
)

print("\n========== RANDOM FOREST RESULTS ==========")
print("Accuracy:", accuracy)


# ============================================================
# 19. CLASSIFICATION REPORT
# ============================================================

# Precision, Recall aur F1 Score check kar rahe hain
print("\nClassification Report:")

print(
    classification_report(
        y_category_test,
        y_category_pred
    )
)


# ============================================================
# 20. CONFUSION MATRIX
# ============================================================

# Confusion Matrix se pata chalega ke
# Low, Medium aur High mein kitni predictions correct hain

cm = confusion_matrix(
    y_category_test,
    y_category_pred
)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    xticklabels=["Low", "Medium", "High"],
    yticklabels=["Low", "Medium", "High"]
)

plt.title("Confusion Matrix - Random Forest")
plt.xlabel("Predicted Category")
plt.ylabel("Actual Category")

plt.show()


# ============================================================
# 21. FEATURE IMPORTANCE
# ============================================================

# Random Forest batayega ke kaun se features prediction mein
# sab se zyada important hain

importance = pd.Series(
    random_forest.feature_importances_,
    index=features
).sort_values(ascending=False)

print("\nFeature Importance:")
print(importance)


# Feature importance ka graph
plt.figure(figsize=(9, 5))

importance.plot(kind="bar")

plt.title("Feature Importance - Random Forest")
plt.xlabel("Features")
plt.ylabel("Importance")

plt.show()


# ============================================================
# 22. FINAL RESULTS
# ============================================================

print("\n")
print("==============================================")
print("             FINAL PROJECT RESULTS")
print("==============================================")

print("\nLinear Regression:")
print("R2 Score:", r2)
print("MAE:", mae)
print("RMSE:", rmse)

print("\nRandom Forest:")
print("Accuracy:", accuracy)

print("\n==============================================")
print("Project Successfully Completed!")
print("==============================================")